// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username         String?   @unique
  email            String?   @unique
  password         String?
  role             String?   @default("user")
  profile_picture  String?
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @updatedAt @db.Timestamp(6)
  password_changed Boolean   @default(false)
  is_active        Boolean   @default(true)

  accounts  Accounts[] @relation("UserAccounts")
  sessions  Session[]  @relation("UserSessions")
  biography biography?

  @@map("users")
}

model biography {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  users_id   String?   @unique @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @updatedAt @db.Timestamp(6)

  students               students[]
  employees              employees?
  personal_information   personal_information?
  address                address[]
  family_background      family_background[]
  eligibility            eligibility[]
  educational_background educational_background[]
  work_experience        work_experience[]

  users User? @relation(fields: [users_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model Accounts {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation("UserAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String    @unique @map("session_token")
  userId       String    @map("user_id") @db.Uuid
  expires      DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model divisions {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  division    String    @unique
  description String?
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @updatedAt @db.Timestamp(6)

  employees employees[]
}

model departments {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department  String    @unique
  description String?
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @updatedAt @db.Timestamp(6)

  employees employees[]
  positions positions[]
}

model positions {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  position       String    @unique
  departments_id String?   @db.Uuid
  description    String?
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @updatedAt @db.Timestamp(6)

  departments departments? @relation(fields: [departments_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  employees employees_positions[]
}

model employees_positions {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employees_id String    @db.Uuid
  positions_id String    @db.Uuid
  is_active    Boolean   @default(false)
  description  String?
  status       String?
  start_at     DateTime? @db.Timestamp(6)
  end_at       DateTime? @db.Timestamp(6)

  employees employees @relation(fields: [employees_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  positions positions @relation(fields: [positions_id], references: [id])
}

model employees {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  biography_id   String                @unique @db.Uuid
  id_number      String                @unique
  hired_at       DateTime?             @db.Timestamp(6)
  remarks        String?
  created_at     DateTime              @default(now()) @db.Timestamp(6)
  updated_at     DateTime?             @updatedAt @db.Timestamp(6)
  divisions_id   String?               @db.Uuid
  departments_id String?               @db.Uuid
  positions      employees_positions[]
  government_ids employees_govIDs[]

  biography   biography    @relation(fields: [biography_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  divisions   divisions?   @relation(fields: [divisions_id], references: [id])
  departments departments? @relation(fields: [departments_id], references: [id])
}

model employees_govIDs {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employees_id String    @db.Uuid
  id_label     String
  id_number    String
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @updatedAt @db.Timestamp(6)

  employees employees? @relation(fields: [employees_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model personal_information {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  biography_id String    @unique @db.Uuid
  surname      String
  firstname    String
  middlename   String?
  extension    String?
  birthdate    DateTime? @db.Timestamp(6)
  birthplace   String?
  sex          String
  civil_status String
  telephone_no String?
  mobile_no    String?
  email        String?
  nationality  String
  height       String?
  weight       String?
  blood_type   String?

  biography biography @relation(fields: [biography_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model address {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  biography_id String    @db.Uuid
  address_type String
  region       String?
  province     String?
  city         String?
  barangay     String?
  house_no     String?
  street       String?
  subdivision  String?
  zip_code     String?
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @updatedAt @db.Timestamp(6)

  biography biography @relation(fields: [biography_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model family_background {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  biography_id       String    @db.Uuid
  relation_type      String
  surname            String?
  firstname          String?
  middlename         String?
  extension          String?
  occupation         String?
  employer           String?
  occupation_address String?
  contact_no         String?
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @updatedAt @db.Timestamp(6)

  biography biography @relation(fields: [biography_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model eligibility {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  biography_id      String    @db.Uuid
  qualification     String?
  rating            String?
  date_examination  DateTime?
  place_examination String?
  id_number         String?
  date_validity     String?
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @updatedAt @db.Timestamp(6)

  biography biography @relation(fields: [biography_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model educational_background {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  biography_id   String    @db.Uuid
  level          String?
  school         String?
  degree         String?
  date_from      DateTime?
  date_to        DateTime?
  units_earned   String?
  year_graduated String?
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @updatedAt @db.Timestamp(6)

  biography biography @relation(fields: [biography_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model work_experience {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  biography_id       String    @db.Uuid
  date_from          DateTime?
  date_to            DateTime?
  position_title     String?
  company            String?
  monthly_salary     Decimal?  @db.Decimal(10, 2)
  appointment_status String?
  gov_service        Boolean
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @updatedAt @db.Timestamp(6)

  biography biography @relation(fields: [biography_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model semesters {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  semester    String       @unique
  is_active   Boolean      @default(false)
  description String?
  order       Int?         @unique
  created_at  DateTime     @default(now()) @db.Timestamp(6)
  updated_at  DateTime?    @updatedAt @db.Timestamp(6)
  students    students[]
  checklists  checklists[]
}

model acad_years {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acad_year  String    @unique
  is_active  Boolean   @default(false)
  order      Int?      @unique
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime? @updatedAt @db.Timestamp(6)

  students   students[]
  checklists checklists[]
}

model acad_level {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acad_level_code String    @unique
  acad_level_name String?
  description     String?
  order           Int?      @unique
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @updatedAt @db.Timestamp(6)

  students     students[]
  years        year_level[]
  sections     sections[]
  scholarships scholarships[]
}

model year_level {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acad_level_id String       @db.Uuid
  year_level    String       @unique
  description   String?
  order         Int?         @unique
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime?    @updatedAt @db.Timestamp(6)
  checklists    checklists[]

  acad_level acad_level @relation(fields: [acad_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students   students[]
}

model sections {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acad_level_id String    @db.Uuid
  section       String    @unique
  description   String?
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt @db.Timestamp(6)

  acad_level acad_level @relation(fields: [acad_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students   students[]
}

model students {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  biography_id   String    @db.Uuid
  id_number      String
  semester_id    String?   @db.Uuid
  acad_year_id   String?   @db.Uuid
  acad_level_id  String?   @db.Uuid
  course_id      String?   @db.Uuid
  year_level_id  String?   @db.Uuid
  sections_id    String?   @db.Uuid
  student_type   String?
  scholarship_id String?   @db.Uuid
  discount       Decimal?  @db.Decimal(10, 2)
  assessed_at    DateTime?
  enrolled_at    DateTime?
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @updatedAt @db.Timestamp(6)

  semesters    semesters?    @relation(fields: [semester_id], references: [id])
  acad_years   acad_years?   @relation(fields: [acad_year_id], references: [id])
  acad_level   acad_level?   @relation(fields: [acad_level_id], references: [id])
  course       courses?      @relation(fields: [course_id], references: [id])
  year_level   year_level?   @relation(fields: [year_level_id], references: [id])
  sections     sections?     @relation(fields: [sections_id], references: [id])
  biography    biography     @relation(fields: [biography_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scholarships scholarships? @relation(fields: [scholarship_id], references: [id])

  subjects student_subjects[]
}

model scholarships {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acad_level_id String    @db.Uuid
  scholarship   String
  description   String?
  amount        Decimal?  @db.Decimal(10, 2)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt @db.Timestamp(6)

  acad_level acad_level @relation(fields: [acad_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  students   students[]
}

model courses {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department_id String       @db.Uuid
  course_code   String       @unique
  course_name   String?
  created_by    String
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime?    @updatedAt @db.Timestamp(6)
  checklists    checklists[]
  students      students[]
}

model checklists {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acad_year_id  String    @db.Uuid
  semester_id   String    @db.Uuid
  course_id     String    @db.Uuid
  year_level_id String    @db.Uuid
  sections_id   String?   @db.Uuid
  time          String?
  room          String?
  professor     String?
  subject_code  String
  subject_name  String
  unit          String?
  created_by    String
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt @db.Timestamp(6)

  courses    courses    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  semesters  semesters  @relation(fields: [semester_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  acad_years acad_years @relation(fields: [acad_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  year_level year_level @relation(fields: [year_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model student_subjects {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  students_id   String    @db.Uuid
  checklists_id String    @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt @db.Timestamp(6)

  students students? @relation(fields: [students_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model student_installments {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullname       String?
  id_number      String?
  semester_name  String?
  acad_year_name String?
  label          String?
  amount         Decimal?  @db.Decimal(10, 2)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @updatedAt @db.Timestamp(6)
}

model student_payments {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullname       String?
  id_number      String?
  semester_name  String?
  acad_year_name String?
  section_name   String?
  label          String?
  amount         Decimal?  @db.Decimal(10, 2)
  or_number      String?
  payment_date   DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @updatedAt @db.Timestamp(6)
}
